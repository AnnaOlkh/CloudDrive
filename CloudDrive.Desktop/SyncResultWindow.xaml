<Window x:Class="CloudDrive.Desktop.SyncResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Synchronization result" Width="620" Height="520" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel Margin="24,20,24,20">
    <Button DockPanel.Dock="Bottom" Content="Close" IsDefault="True" IsCancel="True" MinWidth="100"
            HorizontalAlignment="Right" Margin="0,16,0,0" Style="{StaticResource AccentButtonStyle}"/>

    <StackPanel DockPanel.Dock="Top">
      <StackPanel Orientation="Horizontal">
        <TextBlock x:Name="StatusIcon" Style="{StaticResource Icon}" FontSize="26" Margin="0,0,12,0"/>
        <StackPanel>
          <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock x:Name="SubtitleText" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" MaxWidth="470"/>
        </StackPanel>
      </StackPanel>

      <UniformGrid Columns="5" Margin="0,18,0,16">
        <Border Style="{StaticResource Card}" Padding="10,8" Margin="0,0,6,0">
          <StackPanel><TextBlock x:Name="TransferredText" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Transferred" Style="{StaticResource Secondary}" FontSize="12"/></StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Padding="10,8" Margin="0,0,6,0">
          <StackPanel><TextBlock x:Name="DeletedText" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Deleted" Style="{StaticResource Secondary}" FontSize="12"/></StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Padding="10,8" Margin="0,0,6,0">
          <StackPanel><TextBlock x:Name="PendingText" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Kept for later" Style="{StaticResource Secondary}" FontSize="12"/></StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Padding="10,8" Margin="0,0,6,0">
          <StackPanel><TextBlock x:Name="ConflictText" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Conflicts" Style="{StaticResource Secondary}" FontSize="12"/></StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Padding="10,8">
          <StackPanel><TextBlock x:Name="FailedText" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Failed" Style="{StaticResource Secondary}" FontSize="12"/></StackPanel>
        </Border>
      </UniformGrid>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <StackPanel x:Name="ConflictSection" Visibility="Collapsed" Margin="0,0,0,14">
          <TextBlock Text="Conflicts – changed on both sides, neither version was overwritten" FontWeight="SemiBold" Foreground="{StaticResource Warning}"/>
          <ItemsControl x:Name="ConflictList" Margin="0,6,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2"/></DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <StackPanel x:Name="FailureSection" Visibility="Collapsed">
          <TextBlock Text="Failed" FontWeight="SemiBold" Foreground="{StaticResource Danger}"/>
          <ItemsControl x:Name="FailureList" Margin="0,6,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2"/></DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
