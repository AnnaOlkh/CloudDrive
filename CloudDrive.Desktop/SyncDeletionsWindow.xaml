<Window x:Class="CloudDrive.Desktop.SyncDeletionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Confirm deletions" Width="600" Height="470" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel Margin="24,20,24,20">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <StackPanel Orientation="Horizontal">
        <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" Foreground="{StaticResource Danger}" FontSize="22" Margin="0,0,12,0"/>
        <TextBlock Text="Files deleted since the last sync" FontSize="20" FontWeight="SemiBold"/>
      </StackPanel>
      <TextBlock Text="Tick the deletions to apply on the other side. Anything you leave unticked is kept and asked about again next time."
                 TextWrapping="Wrap" Style="{StaticResource Secondary}" Margin="0,8,0,0"/>
    </StackPanel>

    <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
        <Button Content="Select all" Click="SelectAll_Click" Margin="0,0,8,0"/>
        <Button Content="Select none" Click="SelectNone_Click"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Keep all" Click="KeepAll_Click" MinWidth="90" Margin="0,0,10,0"/>
        <Button Content="Apply selected" Click="Apply_Click" MinWidth="130" IsDefault="True" Style="{StaticResource AccentButtonStyle}"/>
      </StackPanel>
    </Grid>

    <Border Style="{StaticResource Card}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Items}" Margin="8">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" Margin="6,6" HorizontalAlignment="Stretch">
                <StackPanel Margin="4,0,0,0">
                  <TextBlock Text="{Binding Path}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding Action}" Style="{StaticResource Secondary}" FontSize="12"/>
                </StackPanel>
              </CheckBox>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
  </DockPanel>
</Window>
