<Window x:Class="CloudDrive.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="CloudDrive – Sign in" Width="780" Height="520" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Surface}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Brand panel -->
    <Border Grid.Column="0" Background="{StaticResource Brand}" ClipToBounds="True">
      <Grid>
        <TextBlock Style="{StaticResource Icon}" Text="&#xE753;" FontSize="240" Foreground="White" Opacity="0.08"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-40,0,0,-60"/>
        <StackPanel VerticalAlignment="Center" Margin="32,0">
          <Border Width="48" Height="48" CornerRadius="12" Background="White" HorizontalAlignment="Left" Margin="0,0,0,18">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE753;" FontSize="26" Foreground="{StaticResource Brand}"
                       HorizontalAlignment="Center"/>
          </Border>
          <TextBlock Text="CloudDrive" FontSize="30" FontWeight="Bold" Foreground="White"/>
          <TextBlock Text="Your files on your own server – browse, preview and keep folders in sync."
                     Foreground="#C9D8F5" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="21"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Form -->
    <Grid Grid.Column="1" Margin="44,0,44,0" VerticalAlignment="Center">
      <StackPanel>
        <TextBlock Text="Welcome back" FontSize="26" FontWeight="SemiBold"/>
        <TextBlock Text="Sign in, or create an account on the server below." Style="{StaticResource Secondary}" Margin="0,4,0,22"/>

        <TextBox x:Name="ServerBox" ui:ControlHelper.Header="Server" ui:ControlHelper.PlaceholderText="https://example.com/" Margin="0,0,0,14"/>
        <TextBox x:Name="UsernameBox" ui:ControlHelper.Header="Username" Margin="0,0,0,14"/>
        <PasswordBox x:Name="PasswordBox" ui:ControlHelper.Header="Password" Margin="0,0,0,20"/>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="SignInButton" Grid.Column="0" Content="Sign in" Click="SignIn_Click" IsDefault="True"
                  Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" MinHeight="36"/>
          <Button x:Name="RegisterButton" Grid.Column="2" Content="Create account" Click="Register_Click"
                  HorizontalAlignment="Stretch" MinHeight="36"/>
        </Grid>

        <ProgressBar x:Name="BusyBar" IsIndeterminate="True" Height="3" Margin="0,14,0,0" Visibility="Hidden"/>

        <Border x:Name="ErrorBanner" Visibility="Collapsed" Background="#FDECEA" BorderBrush="#F5C2BD" BorderThickness="1"
                CornerRadius="6" Padding="12,9" Margin="0,12,0,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{StaticResource Danger}" Margin="0,1,10,0" VerticalAlignment="Top"/>
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{StaticResource Danger}" MaxWidth="330"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
