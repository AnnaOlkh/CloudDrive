<Application x:Class="CloudDrive.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:local="clr-namespace:CloudDrive.Desktop"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:ThemeResources />
        <ui:XamlControlsResources />
      </ResourceDictionary.MergedDictionaries>

      <!-- Palette (light theme is forced in App.xaml.cs, so screenshots look the same everywhere) -->
      <SolidColorBrush x:Key="AppBackground" Color="#F3F5F9"/>
      <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="Line" Color="#E3E7EE"/>
      <SolidColorBrush x:Key="TextSecondary" Color="#66728A"/>
      <SolidColorBrush x:Key="Brand" Color="#173F88"/>
      <SolidColorBrush x:Key="Accent" Color="#2864DC"/>
      <SolidColorBrush x:Key="AccentSoft" Color="#E8F0FE"/>
      <SolidColorBrush x:Key="Danger" Color="#C42B1C"/>
      <SolidColorBrush x:Key="Success" Color="#1E8E5A"/>
      <SolidColorBrush x:Key="Warning" Color="#B7791F"/>

      <!-- Converters -->
      <local:FileSizeConverter x:Key="FileSize"/>
      <local:LocalTimeConverter x:Key="LocalTime"/>
      <local:FileIconConverter x:Key="FileIcon"/>

      <!-- Shared styles -->
      <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>

      <Style x:Key="Secondary" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
      </Style>

      <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
      </Style>

      <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="9,7"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Margin" Value="0"/>
      </Style>

      <Style x:Key="GridCellText" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Margin" Value="4,0"/>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
