<Window x:Class="CloudDrive.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="CloudDrive" Width="1260" Height="800" MinWidth="1060" MinHeight="620"
        Background="{StaticResource AppBackground}"
        AllowDrop="True" DragOver="Window_DragOver" DragLeave="Window_DragLeave" Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ===== Header ===== -->
    <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource Brand}">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE753;" Foreground="White" HorizontalAlignment="Center"/>
          </Border>
          <TextBlock Text="CloudDrive" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Brand}" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBox x:Name="SearchBox" Grid.Column="1" ui:ControlHelper.PlaceholderText="Search in this folder  (Ctrl+F)"
                 MaxWidth="480" HorizontalAlignment="Stretch" Margin="40,0,40,0" VerticalAlignment="Center"
                 TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"/>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource AccentSoft}">
            <TextBlock x:Name="UserInitial" Foreground="{StaticResource Accent}" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock x:Name="UserNameText" Margin="10,0,12,0" VerticalAlignment="Center" MaxWidth="150" TextTrimming="CharacterEllipsis"/>
          <Button Content="Sign out" Click="SignOut_Click" Margin="0"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===== Body ===== -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="250"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Sidebar: folder tree -->
      <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="18,14,10,6">
            <TextBlock Text="Folders" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="NewFolderButton" Style="{StaticResource IconButton}" ToolTip="New folder inside the selected one" Click="NewFolder_Click">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE8F4;"/>
              </Button>
              <Button x:Name="DeleteFolderButton" Style="{StaticResource IconButton}" ToolTip="Delete the selected folder" Click="DeleteFolder_Click">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;"/>
              </Button>
            </StackPanel>
          </Grid>

          <TreeView x:Name="FolderTree" Background="Transparent" BorderThickness="0" Margin="6,0,6,8"
                    SelectedItemChanged="FolderTree_SelectedItemChanged"
                    PreviewMouseRightButtonDown="FolderTree_PreviewMouseRightButtonDown">
            <TreeView.ItemContainerStyle>
              <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
              </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
              <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" Margin="0,3">
                  <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="#E0A030" Margin="0,0,9,0"/>
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
            <TreeView.ContextMenu>
              <ContextMenu>
                <MenuItem Header="New folder here" Click="NewFolder_Click"/>
                <MenuItem x:Name="DeleteFolderMenuItem" Header="Delete folder" Click="DeleteFolder_Click"/>
                <Separator/>
                <MenuItem Header="Upload files here" Click="Upload_Click"/>
                <MenuItem Header="Sync with a local folder" Click="Sync_Click"/>
              </ContextMenu>
            </TreeView.ContextMenu>
          </TreeView>
        </DockPanel>
      </Border>

      <!-- Main area -->
      <Grid Grid.Column="1" Margin="24,18,24,14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock x:Name="FolderTitle" Text="My Drive" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock x:Name="FolderPathText" Style="{StaticResource Secondary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <TextBlock x:Name="FolderSummary" Style="{StaticResource Secondary}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Orientation="Horizontal">
            <Button x:Name="UploadButton" Click="Upload_Click" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0" ToolTip="Upload files (Ctrl+U)">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE898;" Margin="0,0,8,0"/><TextBlock Text="Upload"/>
              </StackPanel>
            </Button>
            <Button x:Name="DownloadButton" Click="Download_Click" Margin="0,0,8,0" ToolTip="Save the selected file to disk">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Margin="0,0,8,0"/><TextBlock Text="Download"/>
              </StackPanel>
            </Button>
            <Button x:Name="DeleteButton" Click="Delete_Click" Margin="0,0,8,0" ToolTip="Delete the selected file (Del)">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" Margin="0,0,8,0"/><TextBlock Text="Delete"/>
              </StackPanel>
            </Button>
            <Button x:Name="SyncButton" Click="Sync_Click" Margin="0,0,0,0" ToolTip="Synchronize a local folder with this remote folder">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" Margin="0,0,8,0"/><TextBlock Text="Sync folder"/>
              </StackPanel>
            </Button>
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE8CB;" Foreground="{StaticResource TextSecondary}" Margin="0,0,6,0"/>
            <ComboBox x:Name="SortCombo" Width="128" SelectedIndex="0" SelectionChanged="Query_Changed" ToolTip="Sort order" Margin="0,0,14,0">
              <ComboBoxItem Content="Name A → Z" Tag="NameAsc"/>
              <ComboBoxItem Content="Name Z → A" Tag="NameDesc"/>
            </ComboBox>
            <TextBlock Style="{StaticResource Icon}" Text="&#xE71C;" Foreground="{StaticResource TextSecondary}" Margin="0,0,6,0"/>
            <ComboBox x:Name="FilterCombo" Width="128" SelectedIndex="0" SelectionChanged="Query_Changed" ToolTip="Show only these file types" Margin="0,0,10,0">
              <ComboBoxItem Content="All files" Tag="All"/>
              <ComboBoxItem Content="TXT + JPG" Tag="TxtJpg"/>
              <ComboBoxItem Content="TXT only" Tag="TxtOnly"/>
              <ComboBoxItem Content="JPG only" Tag="JpgOnly"/>
            </ComboBox>
            <Button x:Name="ColumnsButton" Click="Columns_Click" ToolTip="Choose which columns are visible" Margin="0,0,6,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Margin="0,0,8,0"/><TextBlock Text="Columns"/>
              </StackPanel>
              <Button.ContextMenu>
                <ContextMenu x:Name="ColumnsMenu">
                  <MenuItem x:Name="MenuSize" Header="Size" IsCheckable="True" StaysOpenOnClick="True" Click="ColumnMenu_Click"/>
                  <MenuItem x:Name="MenuCreated" Header="Created" IsCheckable="True" StaysOpenOnClick="True" Click="ColumnMenu_Click"/>
                  <MenuItem x:Name="MenuModified" Header="Modified" IsCheckable="True" StaysOpenOnClick="True" Click="ColumnMenu_Click"/>
                  <MenuItem x:Name="MenuUploaded" Header="Uploaded by" IsCheckable="True" StaysOpenOnClick="True" Click="ColumnMenu_Click"/>
                  <MenuItem x:Name="MenuEdited" Header="Edited by" IsCheckable="True" StaysOpenOnClick="True" Click="ColumnMenu_Click"/>
                </ContextMenu>
              </Button.ContextMenu>
            </Button>
            <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Click="Refresh_Click" ToolTip="Refresh (F5)">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;"/>
            </Button>
          </StackPanel>
        </Grid>

        <!-- Files + details -->
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="360"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="340" MinWidth="260" MaxWidth="620"/>
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Style="{StaticResource Card}">
            <Grid>
              <DataGrid x:Name="FilesGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                        HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="42" CanUserAddRows="False"
                        CanUserResizeRows="False" BorderThickness="0" Background="Transparent" Margin="4"
                        SelectionChanged="FilesGrid_SelectionChanged" Sorting="FilesGrid_Sorting"
                        MouseDoubleClick="FilesGrid_MouseDoubleClick" PreviewKeyDown="FilesGrid_PreviewKeyDown"
                        PreviewMouseRightButtonDown="FilesGrid_PreviewMouseRightButtonDown" ContextMenuOpening="FilesGrid_ContextMenuOpening">
                <DataGrid.Columns>
                  <DataGridTemplateColumn x:Name="NameColumn" Header="Name" SortMemberPath="Name" Width="2.4*" MinWidth="180">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="8,0">
                          <TextBlock Style="{StaticResource Icon}" FontSize="18" Margin="0,0,10,0"
                                     Text="{Binding Name, Converter={StaticResource FileIcon}, ConverterParameter=glyph}"
                                     Foreground="{Binding Name, Converter={StaticResource FileIcon}, ConverterParameter=brush}"/>
                          <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn x:Name="SizeColumn" Header="Size" Binding="{Binding Size, Converter={StaticResource FileSize}}"
                                      SortMemberPath="Size" Width="*" MinWidth="80" ElementStyle="{StaticResource GridCellText}"/>
                  <DataGridTextColumn x:Name="CreatedColumn" Header="Created" Binding="{Binding CreatedAt, Converter={StaticResource LocalTime}}"
                                      SortMemberPath="CreatedAt" Width="1.4*" MinWidth="120" ElementStyle="{StaticResource GridCellText}"/>
                  <DataGridTextColumn x:Name="ModifiedColumn" Header="Modified" Binding="{Binding ModifiedAt, Converter={StaticResource LocalTime}}"
                                      SortMemberPath="ModifiedAt" Width="1.4*" MinWidth="120" ElementStyle="{StaticResource GridCellText}"/>
                  <DataGridTextColumn x:Name="UploadedColumn" Header="Uploaded by" Binding="{Binding UploadedBy}"
                                      Width="*" MinWidth="90" ElementStyle="{StaticResource GridCellText}"/>
                  <DataGridTextColumn x:Name="EditedColumn" Header="Edited by" Binding="{Binding LastEditedBy}"
                                      Width="*" MinWidth="90" ElementStyle="{StaticResource GridCellText}"/>
                </DataGrid.Columns>
                <DataGrid.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Download" Click="Download_Click"/>
                    <MenuItem Header="Delete" Click="Delete_Click"/>
                  </ContextMenu>
                </DataGrid.ContextMenu>
              </DataGrid>

              <!-- Empty state -->
              <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="44" Foreground="#C5CCD9" HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyTitle" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <TextBlock x:Name="EmptyHint" Style="{StaticResource Secondary}" HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320"/>
              </StackPanel>
            </Grid>
          </Border>

          <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent" ShowsPreview="False"/>

          <!-- Details + preview -->
          <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
            <Grid>
              <StackPanel x:Name="PreviewEmpty" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="40" Foreground="#C5CCD9" HorizontalAlignment="Center"/>
                <TextBlock Text="Select a file" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <TextBlock Text="Details appear here. .c files show as text and .jpg files as images." Style="{StaticResource Secondary}"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="240" Margin="0,4,0,0"/>
              </StackPanel>

              <Grid x:Name="PreviewContent" Visibility="Collapsed">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                  <TextBlock x:Name="PreviewIcon" Style="{StaticResource Icon}" FontSize="30" Margin="0,0,12,0"/>
                  <TextBlock x:Name="PreviewTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="250" VerticalAlignment="Center"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,0,0,14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Size" Style="{StaticResource Secondary}" Margin="0,3,18,3"/>
                  <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DetailSize" Margin="0,3" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Created" Style="{StaticResource Secondary}" Margin="0,3,18,3"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DetailCreated" Margin="0,3" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Modified" Style="{StaticResource Secondary}" Margin="0,3,18,3"/>
                  <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DetailModified" Margin="0,3" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Row="3" Grid.Column="0" Text="Uploaded by" Style="{StaticResource Secondary}" Margin="0,3,18,3"/>
                  <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DetailUploaded" Margin="0,3" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Row="4" Grid.Column="0" Text="Edited by" Style="{StaticResource Secondary}" Margin="0,3,18,3"/>
                  <TextBlock Grid.Row="4" Grid.Column="1" x:Name="DetailEdited" Margin="0,3" TextTrimming="CharacterEllipsis"/>
                </Grid>

                <Border Grid.Row="2" Background="{StaticResource AppBackground}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6">
                  <Grid ClipToBounds="True">
                    <TextBlock x:Name="PreviewHint" Style="{StaticResource Secondary}" TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"/>
                    <TextBox x:Name="TextPreview" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12.5" BorderThickness="0"
                             Background="Transparent" Padding="10" Visibility="Collapsed"/>
                    <Image x:Name="ImagePreview" Stretch="Uniform" Margin="6" Visibility="Collapsed"/>
                  </Grid>
                </Border>
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>

    <!-- ===== Status bar ===== -->
    <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,7">
      <DockPanel>
        <ProgressBar x:Name="BusyBar" DockPanel.Dock="Right" Width="140" Height="4" IsIndeterminate="True" Visibility="Hidden" VerticalAlignment="Center"/>
        <TextBlock x:Name="StatusText" Text="Ready" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>

    <!-- ===== Drag & drop overlay ===== -->
    <Grid x:Name="DropOverlay" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed" IsHitTestVisible="False" Background="#E6F3F7FF">
      <Rectangle Margin="28" RadiusX="14" RadiusY="14" Stroke="{StaticResource Accent}" StrokeThickness="2" StrokeDashArray="6 4"/>
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border Width="84" Height="84" CornerRadius="42" Background="{StaticResource AccentSoft}" HorizontalAlignment="Center">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE898;" FontSize="38" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
        </Border>
        <TextBlock Text="Drop files to upload" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Brand}" HorizontalAlignment="Center" Margin="0,16,0,0"/>
        <TextBlock x:Name="DropTargetText" Style="{StaticResource Secondary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
