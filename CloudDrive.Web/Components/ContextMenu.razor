<div class="ctx-backdrop" @onclick="OnClose" @oncontextmenu="OnClose" @oncontextmenu:preventDefault></div>
<div class="ctx-menu" style="left:min(@(X)px, calc(100vw - 220px)); top:min(@(Y)px, calc(100vh - 140px));" role="menu">
    @ChildContent
</div>

@code {
    [Parameter] public int X { get; set; }
    [Parameter] public int Y { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
